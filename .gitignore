# Local exploration / planning artifacts, not part of the deliverable
meta/

# Agent-tool isolation worktrees. The Agent runtime creates short-lived
# worktrees under .claude/worktrees/ for `isolation: "worktree"` spawns
# and does not always clean them up. They are local-only checkouts of
# already-pushed branches — never part of the deliverable. Tracked
# committed agent material (skills, settings) lives elsewhere under
# .claude/ and is NOT covered by this rule.
.claude/worktrees/

# Python bytecode
__pycache__/
*.pyc

# uv / venv
.venv/

# pytest
.pytest_cache/

# jupyter local state
.ipynb_checkpoints/

# Local environment variables — see .env.example for the template
.env

# Output artifacts from runnable examples (rendered frames, timeline
# figures, …). Examples write here; not tracked.
examples/_out/
